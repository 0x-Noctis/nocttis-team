# Salin ke `.env` (tidak masuk git/image). Dipakai oleh `docker compose` (otomatis) dan `. ./.env` pada jalan tanpa Docker.
# Penjelasan lengkap tiap variabel: docs/operations.md. Nilai di sini adalah contoh pengembangan lokal.

# --- WAJIB ---
# Koneksi PostgreSQL. Pada Compose nilai ini diganti otomatis ke host `postgres`; password di bawah hanya untuk dev.
DATABASE_URL=postgres://ai_team:ai_team_dev@127.0.0.1:5432/ai_team
# Server menolak start bila kosong. Ini juga nama default untuk kolom "API key env" saat mendaftarkan provider di UI:
# provider membaca key dari variable yang NAMA-nya Anda tulis di sana, jadi isi variable itu di environment backend.
PRIMARY_API_KEY=

# --- Hanya dibaca Docker Compose (diteruskan ke NOCTIS__PROVIDER__*) ---
# Bukan pendaftaran provider; hanya bawaan untuk halaman Settings dan ID model default scheduler.
# PRIMARY_MODEL harus SAMA PERSIS dengan "Model ID" yang Anda daftarkan di halaman Providers.
PRIMARY_BASE_URL=https://api.openai.com/v1
PRIMARY_MODEL=gpt-5-mini

# --- Opsional ---
# Berkas konfigurasi non-secret (lihat config/example.toml). Tanpa ini dipakai nilai bawaan.
NOCTIS_CONFIG=config/example.toml
# Daftar host persis (dipisah koma) untuk provider internal tepercaya. Tanpa ini probe ke loopback/privat ditolak (anti-SSRF);
# pemeriksaan ini hanya berlaku pada probe, bukan pada panggilan model saat run.
# NOCTIS_PROVIDER_HOST_ALLOWLIST=127.0.0.1,localhost
# Image container untuk perintah verifikasi task. Satu image untuk seluruh server; bawaan `rust:1`.
# Proyek Node memerlukan image yang berisi Node, mis. node:22-bookworm-slim. Pakai tag yang di-pin.
# NOCTIS_RUNNER_IMAGE=rust:1
# Timpa nilai config tanpa mengedit berkas: NOCTIS__<SECTION>__<FIELD> (tepat dua segmen), mis.
# NOCTIS__SERVER__BIND=127.0.0.1:7411
# NOCTIS__SERVER__WEB_ROOT=web/build
# NOCTIS__SCHEDULER__MAX_PARALLEL_AGENTS=4
# Filter log (JSON ke stdout). Tanpa ini level `info`. Hindari `debug` di produksi.
RUST_LOG=ai_team=debug,tower_http=info
